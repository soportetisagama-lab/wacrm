# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# Shared admin authorization code gating account creation and
# password-reset requests. Required — without it, POST /api/auth/signup
# (for signups with no invite link) and POST /api/auth/forgot-password
# reject every request (fail closed), so nobody can create an account
# or trigger a reset email without knowing this value. Signups that
# arrive via a valid /join/<token> invite link are exempt — the invite
# itself is the authorization there.
# Never prefix this with NEXT_PUBLIC_ — it must never reach the client
# bundle. Generate any long random string:
#   openssl rand -hex 32
AUTH_ADMIN_CODE=generate-a-long-random-string

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Default language locale (e.g. es, en, ko)
NEXT_PUBLIC_APP_LOCALE=es

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# xlr8 status sync (optional)
# ------------------------------------------------------------------
# Mirrors each phone's status in the legacy xlr8 CRM (estado_xlr9.php)
# as a shared contact tag (ASIGNADO, NO CONTESTADO, CONTESTADO, ...),
# so broadcasts can filter by it. Runs every 5 min from the flows cron
# and when Broadcasts / Inbox open. If any of the three is missing the
# sync is simply off (one warning in the log).
# XLR8_ESTADOS_URL=https://your-cpanel-host/path/estado_xlr9.php
# Same value as XLR9_TOKEN inside estado_xlr9.php (sent as X-Xlr9-Token).
# XLR8_TOKEN=a-long-random-string
# This line: INOX | MAXI | RETAIL | INDUSTRIAL | CASTOR (also required by
# the automatic derivation below)
# XLR8_LINEA=INOX
# Optional: ventas_xlr9.php (CERRADO projects with monto_venta), same
# XLR8_TOKEN and XLR8_LINEA. Gives Purchase its value (PEN); if unset,
# Purchase is sent without value.
# XLR8_VENTAS_URL=https://your-cpanel-host/path/ventas_xlr9.php

# ------------------------------------------------------------------
# Meta Conversions API for Business Messaging (optional)
# ------------------------------------------------------------------
# Sends WhatsApp conversation signals to Meta (action_source
# business_messaging) ONLY for contacts that came from a Click-to-WhatsApp
# ad (ctwa_clid). The dataset is fetched/created from the line's WABA with
# its WhatsApp token and saved in whatsapp_config (migration 092).
# LeadSubmitted = first message from an ad; QualifiedLead = type tag below;
# InitiateCheckout = quotation document sent (filename/caption with
# "cotiz", "proforma" or "presupuesto"); OrderCreated = ANTICIPO;
# Purchase = CERRADO (+ monto from XLR8_VENTAS_URL). Flow/automation
# buttons can also send a chosen event ("Enviar señal a Meta").
# Anything other than "true" → nothing is sent.
# META_CAPI_ENABLED=true
# xlr8 type tags that mean QualifiedLead, comma separated. Per line:
# INOX=PROYECTO, RETAIL=PROYECTO, CASTOR=PRODUCTO,PROYECTO,
# MAXI=PRODUCTO,PROYECTO, INDUSTRIAL= (empty → no QualifiedLead).
# META_CAPI_QUALIFIED_TAGS=PROYECTO

# ------------------------------------------------------------
# TikTok (DMs of the TikTok Business account) — OPTIONAL.
# ------------------------------------------------------------
# App of TikTok for Business Developers (business-api.tiktok.com).
# While these are unset the channel stays off: the webhook
# (/api/tiktok/webhook) answers 200 and ignores everything, and
# Settings → Redes sociales → TikTok shows "Pendiente de conectar".
# The secret also verifies the webhook signature. Needs migration 087.
# TIKTOK_APP_ID=your-tiktok-app-id
# TIKTOK_APP_SECRET=your-tiktok-app-secret
# Optional: OAuth redirect URL, only if it must differ from
# <this host>/api/tiktok/callback (it must match the portal exactly).
# TIKTOK_REDIRECT_URI=https://crm.example.com/api/tiktok/callback
# Optional: comma-separated OAuth scopes (default in src/lib/tiktok/api.ts).
# TIKTOK_SCOPES=user.info.basic,biz.message.read,biz.message.send

# ------------------------------------------------------------------
# Derivacion automatica a XLR8 (optional)
# ------------------------------------------------------------------
# When the bot (flow or AI) hands a WhatsApp chat to an advisor, the CRM
# POSTs the lead to the XLR8 PHP, which picks the advisor; the chat is
# assigned to the member whose "ID XLR8" (Settings > Members) matches.
# Once per conversation. Needs migrations 088 and 089. Three variables:
# DERIVAR_AUTO_URL and DERIVAR_AUTO_SECRET (if either is unset the
# derivation is off) and XLR8_LINEA (the line sent to the PHP, in the
# xlr8 block above; REQUIRED: if it is unset nothing is derived and the
# log says so, there is no default line).
# Business hours (HORARIO_DERIVACION, Lima time): Mon-Fri 08:00-17:00,
# Sat 08:00-12:00, lunch 13:00-14:00 excluded, never on Sunday. A
# handoff outside those hours is queued and derived by the flows cron
# as soon as the hours open (oldest first).
# TEST MODE: only the numbers in NUMEROS_PRUEBA
# (src/lib/derivacion-auto.ts) are derived.
# DERIVAR_AUTO_URL=https://your-cpanel-host/path/derivar_auto.php
# Sent as the X-Derivar-Secret header; same value as in the PHP.
# DERIVAR_AUTO_SECRET=a-long-random-string
# Chat header "asesores disponibles" indicator (Administrador and ATC
# only): read-only asesores_disponibles.php, same secret and XLR8_LINEA.
# Optional: by default it is DERIVAR_AUTO_URL with the file name swapped.
# ASESORES_DISPONIBLES_URL=https://your-cpanel-host/path/asesores_disponibles.php
